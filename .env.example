# Copie ce fichier en ".env" et remplis tes propres valeurs.
# .env n'est JAMAIS versionné sur Git (voir .gitignore).

# "groq" (gratuit, recommandé pour démarrer) ou "openai"
LLM_PROVIDER=groq

# Nom du modèle chez le fournisseur choisi.
# Pour Groq : openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b...
# Pour OpenAI : gpt-4o-mini, gpt-4o...
LLM_MODEL_NAME=openai/gpt-oss-20b

# Clé API Groq — gratuite sur https://console.groq.com/keys
GROQ_API_KEY=

# Clé API OpenAI — uniquement si LLM_PROVIDER=openai
OPENAI_API_KEY=

# "hybrid" (embeddings + BM25, par défaut) ou "dense" (embeddings seuls)
RETRIEVAL_MODE=hybrid
